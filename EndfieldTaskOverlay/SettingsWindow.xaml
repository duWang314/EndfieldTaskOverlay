<Window x:Class="EndfieldTaskOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Width="325"
        Height="200"
        MinWidth="216.5"
        MinHeight="133"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        Title="SettingsWindow">
    <Border Background="#FFFDFDFD"
            BorderBrush="#FFD8D8D8"
            BorderThickness="1"
            CornerRadius="10"
            Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="设置"
                       HorizontalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="窗口置顶" VerticalAlignment="Center" Margin="0,0,8,6" />
                <CheckBox x:Name="AutoPinCheckBox" Grid.Row="0" Grid.Column="1" IsChecked="True" Margin="0,0,0,6" />

                <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Top" Margin="44,0,-36,0" Text="自动启动游戏" />
                <CheckBox x:Name="AutoLaunchGameCheckBox" Grid.Row="0" Grid.Column="1" IsChecked="False" Margin="124,0,-123,6" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="游戏路径" VerticalAlignment="Center" Margin="0,0,8,6" />
                <TextBox x:Name="GamePathTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="窗口坐标" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Hidden" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="LocationXTextBox"
                             Width="70"
                             Margin="0,0,6,0"
                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                             DataObject.Pasting="NumericTextBox_Pasting"
                             Visibility="Hidden" />
                    <TextBlock Text="," VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Hidden" />
                    <TextBox x:Name="LocationYTextBox"
                             Width="70"
                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                             DataObject.Pasting="NumericTextBox_Pasting"
                             Visibility="Hidden"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Button Content="恢复默认"
                        HorizontalAlignment="Left"
                        Width="52"
                        Height="20"
                        Background="#f0edec"
                        Click="ResetButton_Click" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消"
                            Width="32"
                            Height="20"
                            Margin="0,0,6,0"
                            Background="#f0edec"
                            Click="CancelButton_Click" />
                    <Button Content="确定"
                            Width="32"
                            Height="20"
                            Background="#fded00"
                            Click="ConfirmButton_Click" />
                </StackPanel>
                <Button Content="配置文件"
                    HorizontalAlignment="Left"
                    Width="52"
                    Height="20"
                    Background="#f0edec"
                    Click="OpenJson_Click" Margin="57,0,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
