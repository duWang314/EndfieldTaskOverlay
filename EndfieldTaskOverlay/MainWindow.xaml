<Window x:Class="EndfieldTaskOverlay.MainWindow"
        x:Name="_MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EndfieldTaskOverlay"
        mc:Ignorable="d"
        Width="325"
        Height="200"
        MinWidth="216.5"
        MinHeight="133"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        Topmost="True"
        Title="Endfield Task Overlay"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeave="Window_MouseLeave"
        MouseEnter="Window_MouseEnter">
    <Border Background="#FFFDFDFD"
            BorderBrush="#FFD8D8D8"
            BorderThickness="1"
            CornerRadius="10"
            Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="StartTimerButton" Width="26" Height="22" Margin="2" Content="⏱" ToolTip="开始计时" Click="StartTimerButton_Click" />
                <Button Width="26" Height="22" Margin="2" Content="✏" ToolTip="编辑/载入任务" Click="EditTaskButton_Click" />
                <Button Width="26" Height="22" Margin="2" Content="⚙" ToolTip="设置" Click="SettingsButton_Click" />
                <Button Width="26" Height="22" Margin="2" Content="?" ToolTip="帮助" Click="HelpButton_Click" />
                <Button Width="26" Height="22" Margin="2" Content="✕" ToolTip="关闭" Click="CloseButton_Click" />
            </StackPanel>

            <Grid Grid.Row="0" Margin="0,0,0,10" Height="14" VerticalAlignment="Bottom">
                <TextBlock x:Name="ProgressTextBlock"
                           Text="0 / 0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           FontSize="13"
                           FontWeight="SemiBold" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,10">
                <Viewbox HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        MaxWidth="280"
                        MaxHeight="90">
                    <TextBlock x:Name="TaskTextBlock"
                                Width="282"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                FontSize="23"
                                FontWeight="Bold" Height="60" ><Run Text="未读取到任务      "/><Run Language="zh-cn" Text="            "/><Run Text="请检查 TODO"/></TextBlock>
                </Viewbox>
            </Grid>

            <Grid Grid.Row="2">
                <Button x:Name="PreviousButton"
                        Content="上一步"
                        HorizontalAlignment="Left"
                        Width="60"
                        Height="24"
                        Background="#f0edec"
                        Click="PreviousButton_Click" />
                <Button x:Name="NextButton"
                        Content="下一步"
                        HorizontalAlignment="Right"
                        Width="60"
                        Height="24"
                        Background="#fded00"
                        Click="NextButton_Click" />
            </Grid>

            <Path IsHitTestVisible="False"
                  Grid.Row="2"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,2,2"
                  Stroke="Transparent"
                  StrokeThickness="1"
                  Data="M 0 10 L 10 0 M 4 10 L 10 4 M 8 10 L 10 8" />
            <Thumb x:Name="ResizeThumb"
                Grid.Row="2"
                Width="6"
                Height="6"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Cursor="SizeNWSE"
                Background="Transparent"
                DragDelta="ResizeThumb_DragDelta"
                DragCompleted="ResizeThumb_DragCompleted" Margin="0,0,-6,-6" />
        </Grid>
    </Border>
</Window>
